# Copy to .env. Never commit .env.
#
# This file holds ONLY what the database cannot: where the process listens, and where its
# files are. Everything else - the catalogue, the prices, the gateway and SMS credentials,
# the console key - lives in the console and is edited there.
#
# Every value below has a working default, so the shop runs with no .env at all. The first
# boot mints a console credential and prints it once; sign in at /admin and configure the
# rest from the settings tab.

PORT=3000
NODE_ENV=development

# Where the built client lives in production (the server serves it - one origin).
CLIENT_DIR=../application/dist

# The SSR bundle built by `vite build --ssr` (self-contained; renders the shop per request).
SSR_ENTRY=../application/dist-server/entry.server.js

# Where the BUYER'S BROWSER reaches this site - the gateway sends them back here, so a wrong
# value strands every payment at the bank. In production that is this server (one origin); in
# dev it is the vite origin, because vite serves the pages and proxies /api here.
PUBLIC_BASE_URL=http://localhost:5173

# The gift codes, the order ledger and the settings, in one SQLite file.
#
# TREAT THIS FILE AS THE BUSINESS. It holds unsold codes, which are money, and the credentials
# of the account they are paid into, stored as given - there is no encryption at rest, because
# a key kept beside the ciphertext protects nothing. Back it up, and keep it off any disk a
# redeploy wipes.
DATABASE_FILE=data/nura.db

# OPTIONAL. Fixes the console credential instead of letting the first boot mint one - useful
# when a deployment pipeline needs to know the key in advance. Leave it unset otherwise: no
# default is shipped, because a default in a public repository is a published credential.
#   npm run admin-key --workspace server
# ADMIN_KEY=
