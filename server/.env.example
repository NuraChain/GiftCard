# Copy to .env. Never commit .env.
#
# This file holds ONLY what the database cannot: where the process listens, how it is fronted,
# and where its files are. Everything else - the catalogue, the prices, the gateway and SMS
# credentials, the console key - lives in the console and is edited there.
#
# Every value below has a working default, so the API runs with no .env at all. The first boot
# mints a console credential and prints it once; sign in at /admin and configure the rest from
# the settings tab.

PORT=3000
NODE_ENV=development

# Where the BUYER'S BROWSER reaches this site - the public origin NGINX answers on, not this
# process's own address. The gateway sends the buyer back here, so a wrong value silently
# strands every payment at the bank.
#
# In dev that is the vite origin, because vite serves the pages and proxies /api here.
# In production it is your https hostname.
PUBLIC_BASE_URL=http://localhost:5173

# --- Being behind a proxy ---

# How many proxies sit in front. The per-IP throttles and the console's sign-in lockout are
# only as good as this number: at 0 every buyer shares nginx's address and one attacker locks
# out the whole shop, and trusting the whole chain would let a client forge its own address.
# One nginx in front means 1. Running the API directly, with nothing in front, means 0.
#
# The other half of this is your proxy config, which must OVERWRITE X-Forwarded-For rather
# than appending to it (nginx's usual $proxy_add_x_forwarded_for appends). Both are needed;
# either alone is decorative.
TRUST_PROXY_HOPS=1

# Adds `Secure` to the session cookie. It cannot be inferred from the request: nginx
# terminates TLS, so this process always sees plain http even when the browser is on https.
# On wherever nginx serves https - which is everywhere but a local dev machine.
COOKIE_SECURE=false

# --- Storage and the console ---

# The gift codes, the order ledger, the catalogue and the settings, in one SQLite file.
#
# TREAT THIS FILE AS THE BUSINESS. It holds unsold codes, which are money, and the credentials
# of the account they are paid into, stored as given - there is no encryption at rest, because
# a key kept beside the ciphertext protects nothing. Back it up, and keep it off any disk a
# redeploy wipes.
DATABASE_FILE=data/guardian-service.db

# OPTIONAL. Fixes the console credential instead of letting the first boot mint one - useful
# when a deployment pipeline needs to know the key in advance. Leave it unset otherwise: no
# default is shipped, because a default in a public repository is a published credential.
#
# The shape is four groups of four over A-Z2-9 with no I, O, 0 or 1 - the characters people
# misread copying a key by hand. Unset, the first boot mints one and prints it once.
# ADMIN_KEY=
