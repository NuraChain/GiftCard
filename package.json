{
    "name": "guardian-service",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "application",
        "server"
    ],
    "type": "module",
    "scripts": {
        "dev": "concurrently --names api,web --prefix-colors cyan,magenta --kill-others \"npm:dev:api\" \"npm:dev:web\"",
        "dev:api": "npm start --workspace server",
        "dev:web": "npm run dev --workspace application",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "check": "npm run typecheck && npm run lint && npm run format:check",
        "build": "npm run build --workspace application",
        "test": "npm test --workspaces --if-present",
        "service:install": "bash scripts/service-install.sh",
        "service:start": "bash scripts/service-start.sh",
        "service:stop": "bash scripts/service-stop.sh",
        "service:restart": "bash scripts/service-restart.sh",
        "service:status": "bash scripts/service-status.sh",
        "service:deploy": "npm run build && npm run service:restart",
        "service:uninstall": "bash scripts/service-uninstall.sh"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0"
    },
    "engines": {
        "node": ">=24"
    }
}
