{
    "name": "guardian-service",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "workspaces": [
        "application",
        "server"
    ],
    "scripts": {
        "dev:api": "npm start --workspace server",
        "dev:web": "npm run dev --workspace application",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "check": "npm run typecheck && npm run lint",
        "build": "npm run build --workspace application",
        "test": "npm test --workspaces --if-present",
        "start": "npm start --workspace server"
    },
    "devDependencies": {
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0"
    }
}
