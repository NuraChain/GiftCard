# nginx for this shop. Copy to /etc/nginx/sites-available/guardian-service and symlink it
# into sites-enabled.
#
# THE SPLIT THIS FILE EXISTS TO MAKE. The Node process serves JSON under /api and NOTHING
# else - no pages, no assets, no index.html. nginx serves the built client and proxies /api
# through. Get it backwards and every page answers
#
#     {"error":{"code":"not-found","message":"این آدرس وجود ندارد"}}
#
# which is the API's own 404 telling you it was asked for a page it has never had.

server {
    listen 80;
    server_name guardian-server.ir www.guardian-server.ir;

    # Certbot writes its challenge here, and it has to be reachable over plain http.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name guardian-server.ir www.guardian-server.ir;

    ssl_certificate     /etc/letsencrypt/live/guardian-server.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/guardian-server.ir/privkey.pem;

    # The built client. `npm run build` writes it; the path is the repo checkout, so adjust
    # it to wherever this is deployed.
    root /home/guardian-service/application/dist;
    index index.html;

    # Gift codes and an order ledger. Nothing here belongs in a shared cache.
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # nginx terminates TLS, so this is the only place it can be promised.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # A code is 36 characters and an address is 42; nothing a buyer sends is large.
    client_max_body_size 1m;

    # --- The API ---
    #
    # FIRST, because a prefix location must win over the catch-all below.
    location /api/ {
        proxy_pass http://127.0.0.1:4201;
        proxy_http_version 1.1;

        # X-Forwarded-For is OVERWRITTEN, not appended to.
        #
        # THIS LINE IS A SECURITY CONTROL, and the usual $proxy_add_x_forwarded_for is the
        # wrong one here. It APPENDS, which means a client can write the left of the chain
        # itself - and with TRUST_PROXY_HOPS=1 the app reads exactly one hop back from the
        # end, so an appended header hands the attacker their own rate-limit bucket and
        # their own sign-in lockout. See server/src/platform/throttle.ts, which documents
        # both halves of this together because either alone is decorative.
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;

        # The gateway callback can wait on a verify call to Zarinpal.
        proxy_read_timeout 60s;
    }

    # --- The pages ---
    #
    # try_files, because the client is a single-page app: /admin/orders is a route the
    # ROUTER knows and no file on disk, so every unmatched path has to answer index.html.
    # Without this, a refresh anywhere but / is a 404 from nginx.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed filenames, so these are safe to cache hard - and they are the only things here
    # that are. The no-store above still covers index.html, which is what must never stick.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
