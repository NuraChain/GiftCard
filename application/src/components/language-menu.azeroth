// The language switcher: the current language's flag, and a menu of every language.
//
// Each choice is a real link to that language's page, named IN ITS OWN LANGUAGE - the reader
// who needs this control is exactly the one who cannot read the page it is on. The flag is
// decoration beside the name (`alt=""`): a flag is a country, not a language.
//
// A DISCLOSURE, not an ARIA menu, for the reason given in ./mobile-nav.azeroth: a list of
// links needs no roving focus or key handling beyond Escape, and cannot trap anybody.
import { Link } from 'azerothjs';
import { ChevronDown } from 'lucide';

import { homeOf, LANG_INFO, LANGS, useCopy, useLang, type Lang } from '../lib/lang.ts';
import Icon from '../ui/icon.azeroth';

const COPY: Record<Lang, string> = {
    en: 'Language',
    fa: 'زبان',
    ar: 'اللغة',
    es: 'Idioma',
    pt: 'Idioma',
    hi: 'भाषा',
    zh: '语言',
    ru: 'Язык',
    fr: 'Langue',
    tr: 'Dil'
};

export component Flag(props: { lang: Lang })
{
    <img
        src={ `/flags/${ LANG_INFO[props.lang].flag }.svg` }
        alt=""
        width="20"
        height="15"
        class="h-[15px] w-5 shrink-0 rounded-[3px] object-cover ring-1 ring-line"
    />
}

export default component LanguageMenu()
{
    const current = useLang();
    const label = useCopy(COPY);
    state open = false;
    let trigger: HTMLButtonElement | undefined;
    let panel: HTMLDivElement | undefined;

    effect (open) {
        if (!open) {
            return;
        }
        const onKey = (event: KeyboardEvent): void => {
            if (event.key === 'Escape') {
                open = false;
                trigger?.focus();
            }
        };
        // Armed one task late, like the mobile nav: the press that opened it is still travelling.
        let onOutside: ((event: Event) => void) | undefined;
        const arm = setTimeout(() => {
            onOutside = (event: Event): void => {
                const target = event.target as Node | null;
                if (
                    target !== null &&
                    !(panel?.contains(target) ?? false) &&
                    !(trigger?.contains(target) ?? false)
                ) {
                    open = false;
                }
            };
            document.addEventListener('pointerdown', onOutside);
        }, 0);
        document.addEventListener('keydown', onKey);
        cleanup {
            clearTimeout(arm);
            document.removeEventListener('keydown', onKey);
            if (onOutside !== undefined) {
                document.removeEventListener('pointerdown', onOutside);
            }
        }
    }

    <div class="relative">
        <button
            type="button"
            ref={ (element) => trigger = element }
            class="flex min-h-tap items-center gap-1.5 rounded-xl border border-line px-3 text-small font-bold text-muted hover:border-firouze hover:text-firouze"
            aria-expanded={ open ? 'true' : 'false' }
            aria-controls="language-menu-panel"
            aria-label={ `${ label }: ${ LANG_INFO[current].name }` }
            onClick={ () => open = !open }
        >
            <Flag lang={ current } />
            <span class="hidden sm:inline" lang={ LANG_INFO[current].locale }>{ LANG_INFO[current].name }</span>
            <Icon icon={ ChevronDown } class="size-4" />
        </button>
        <Show when={ open }>
            <div
                id="language-menu-panel"
                ref={ (element) => panel = element }
                class="anim-settle absolute end-0 top-full z-50 mt-2 w-48 rounded-xl border border-line bg-paper p-1.5 shadow-lg"
            >
                <ul class="flex flex-col">
                    <For each={ [...LANGS] } key={ (lang) => lang } let={ lang }>
                        <li>
                            <Link
                                to={ homeOf(lang) }
                                lang={ LANG_INFO[lang].locale }
                                aria-current={ lang === current ? 'true' : undefined }
                                class={ `flex min-h-tap items-center gap-2.5 rounded-lg px-3 text-small hover:bg-surface hover:text-firouze ${
                                    lang === current ? 'font-bold text-firouze' : ''
                                }` }
                                onClick={ () => open = false }
                            >
                                <Flag lang={ lang } />
                                { LANG_INFO[lang].name }
                            </Link>
                        </li>
                    </For>
                </ul>
            </div>
        </Show>
    </div>
}
