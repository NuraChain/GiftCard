// The purchase: phone, confirm, pay, and whatever came back.
//
// Two steps, not one. The confirm step exists because the phone number is the ONLY way the
// code reaches the buyer afterwards, and a mistyped digit is discovered at the worst
// possible moment - after the money has moved. Reading the number back costs one tap and
// catches the typo for free, which is why there is no verification code: an OTP would cost
// the buyer a wait and the operator a message to catch the same mistake.
//
// The result is read from the URL, because the buyer arrives here from the bank rather than
// from a click. `useQuery()` is the router's own reactive view of it - `location.search`
// would be read once and never again.
//
// The form carries `novalidate`: the shared schema owns validation. Without it the
// browser's own constraint check fires first, blocks submit before handleSubmit runs, and
// shows an ENGLISH bubble to a Persian reader.
import { useNavigate, useQuery } from 'azerothjs';
import { ArrowRight, Check, Copy, ShieldCheck, TriangleAlert } from 'lucide';

import { client } from '../api.ts';
import { purchaseFormInput, type Receipt } from '../../../server/src/contract.ts';
import type { CatalogTier } from '../catalog.ts';
import { CONTACT } from '../content.ts';
import { toman } from '../format.ts';
import { icon } from './icon.ts';
import Button from './ui/button.azeroth';
import Field from './ui/field.azeroth';
import TextInput from './ui/text-input.azeroth';
import { useToasts } from './toast.ts';
import CodeCapsule from './code-capsule.azeroth';

export default component PurchasePanel(props: { tier: CatalogTier | undefined })
{
    const query = useQuery();
    const { replace } = useNavigate();
    const notify = useToasts();

    state step: 'phone' | 'confirm' = 'phone';
    state paying = false;
    state failure = '';

    // The receipt: undefined while unknown, null once we know there is nothing to show.
    state receipt: Receipt | null | undefined = undefined;
    state receiptFailed = false;

    derived token = typeof query().receipt === 'string' ? query().receipt as string : '';
    derived strayCallback = query().pay === 'unknown';

    mount
    {
        if (token === '')
        {
            return;
        }
        void client.pay.receipt({ query: { token } })
            .then((value) => { receipt = value; })
            .catch(() => { receiptFailed = true; });
    }

    form purchase = { phone: '' } with
    {
        schema: purchaseFormInput,
        onSubmit: () =>
        {
            failure = '';
            step = 'confirm';
        }
    };

    const pay = async (): Promise<void> =>
    {
        paying = true;
        failure = '';
        try
        {
            const opened = await client.pay.start({
                input: { amount: props.tier?.amount ?? 0, phone: purchase.values().phone }
            });
            // Leaving the page is the success case: the gateway owns the next screen.
            window.location.assign(opened.payUrl);
        }
        catch (error)
        {
            paying = false;
            failure = error instanceof Error && error.message !== ''
                ? error.message
                : 'شروع پرداخت ممکن نشد. اتصال اینترنت را بررسی کنید و دوباره تلاش کنید.';
        }
    };

    const startOver = (): void =>
    {
        receipt = undefined;
        receiptFailed = false;
        step = 'phone';
        purchase.reset();
        replace('/');
    };

    state copied = false;
    // The reset timer is tracked so unmounting cancels it. Left alone, a panel that goes away
    // within two seconds of a copy still fires a write into torn-down state.
    let copyTimer: ReturnType<typeof setTimeout> | undefined;
    cleanup
    {
        clearTimeout(copyTimer);
    }

    const copyCode = async (code: string): Promise<void> =>
    {
        try
        {
            await navigator.clipboard.writeText(code);
            // The confirmation stays ON the button rather than in a toast: the reader's eye
            // is already there, and a notice in the corner of the screen would be further
            // from the action than the action itself.
            copied = true;
            clearTimeout(copyTimer);
            copyTimer = setTimeout(() => { copied = false; }, 2000);
        }
        catch
        {
            // A refused clipboard is the one case worth a notice - the button would
            // otherwise say nothing at all and the buyer would assume the code was taken.
            notify.error('کپی نشد. کد را دستی انتخاب کنید؛ کد شما همان است که می‌بینید.');
        }
    };

    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
        <Switch>
            {/* Coming back from the gateway */}

            <Match when={ strayCallback }>
                <h2 class="font-bold">این پرداخت پیدا نشد</h2>
                <p class="mt-3 text-small text-muted">
                    سفارشی با این مشخصات نداریم. اگر مبلغی از حساب شما کم شده، با پشتیبانی تماس بگیرید تا بررسی کنیم.
                </p>
                <Button class="mt-5" onClick={ startOver }>
                    بازگشت به خرید
                </Button>
            </Match>

            <Match when={ receiptFailed }>
                <h2 class="font-bold">نتیجهٔ پرداخت در دسترس نیست</h2>
                <p class="mt-3 text-small text-muted">
                    نتوانستیم وضعیت این سفارش را بخوانیم. صفحه را دوباره باز کنید؛ اگر باز هم نشد با پشتیبانی تماس بگیرید.
                </p>
                <p class="mt-2 text-small text-muted">
                    <span dir="ltr" class="latin">{ CONTACT.phone }</span>
                </p>
            </Match>

            <Match when={ token !== '' && receipt === undefined }>
                <p class="text-small text-muted">در حال بررسی نتیجهٔ پرداخت...</p>
            </Match>

            <Match when={ receipt?.outcome === 'paid' && receipt.code !== null }>
                <div class="flex items-center gap-2 text-firouze">
                    { icon(ShieldCheck, 'size-5') }
                    <h2 class="font-bold">پرداخت تأیید شد</h2>
                </div>
                <p class="mt-2 text-small text-muted">
                    این کد شماست. تا آن را جایی ذخیره نکرده‌اید صفحه را نبندید.
                </p>

                <div class="mt-5">
                    <CodeCapsule code={ receipt?.code ?? '' } label="کد گیفت کارت شما" verified />
                </div>

                <div class="mt-4 flex flex-wrap gap-3">
                    <Button variant="primary" glyph={ copied ? Check : Copy } onClick={ () => void copyCode(receipt?.code ?? '') }>
                        { copied ? 'کپی شد' : 'کپی کردن کد' }
                    </Button>
                    <Button onClick={ startOver }>
                        خرید کارت دیگر
                    </Button>
                </div>

                <dl class="mt-6 grid gap-2 text-caption text-muted">
                    <div class="flex gap-2">
                        <dt>شمارهٔ پیگیری:</dt>
                        <dd dir="ltr" class="latin">{ String(receipt?.refId ?? '-') }</dd>
                    </div>
                    <div class="flex gap-2">
                        <dt>پرداخت‌شده:</dt>
                        <dd>{ toman(receipt?.toman ?? 0) } تومان</dd>
                    </div>
                    <div class="flex gap-2">
                        <dt>شمارهٔ موبایل:</dt>
                        <dd dir="ltr" class="latin">{ receipt?.phone ?? '' }</dd>
                    </div>
                </dl>

                <p class="mt-4 text-caption text-muted">
                    <Show
                        when={ receipt?.smsDelivered }
                        fallback={ <span>پیامک ارسال نشد، اما کد شما همین است و معتبر است. آن را همین‌جا کپی کنید.</span> }
                    >
                        <span>یک نسخه از این کد با پیامک هم برایتان ارسال شد.</span>
                    </Show>
                </p>
            </Match>

            {/* Money verified, nothing left to hand over. Saying "successful" and showing
                no code would be worse than useless, so this state says what happened. */}
            <Match when={ receipt?.outcome === 'paid' }>
                <div class="flex items-center gap-2 text-nura">
                    { icon(TriangleAlert, 'size-5') }
                    <h2 class="font-bold">پرداخت شما تأیید شد، اما کد آماده نیست</h2>
                </div>
                <p class="mt-3 text-small text-muted">
                    مبلغ از حساب شما کم شده و سفارشتان ثبت است، ولی موجودی کد این کارت همان لحظه تمام شد.
                    با شمارهٔ پیگیری زیر با پشتیبانی تماس بگیرید: یا کد را می‌فرستیم یا کل مبلغ را برمی‌گردانیم.
                </p>
                <div class="mt-4 rounded-xl border border-line bg-paper p-4">
                    <p class="text-caption text-muted">شمارهٔ پیگیری</p>
                    <p dir="ltr" class="latin mt-1 text-start text-lg font-semibold">{ String(receipt?.refId ?? '-') }</p>
                </div>
                <p class="mt-3 text-small">
                    <span dir="ltr" class="latin">{ CONTACT.phone }</span>
                </p>
            </Match>

            <Match when={ receipt?.outcome === 'cancelled' }>
                <h2 class="font-bold">پرداخت لغو شد</h2>
                <p class="mt-3 text-small text-muted">
                    مبلغی از حساب شما کم نشده است. هر وقت خواستید دوباره امتحان کنید.
                </p>
                <Button variant="primary" class="mt-5" onClick={ startOver }>
                    تلاش دوباره
                </Button>
            </Match>

            <Match when={ receipt?.outcome === 'failed' }>
                <h2 class="font-bold">پرداخت تأیید نشد</h2>
                <p class="mt-3 text-small text-muted">
                    بانک این تراکنش را تأیید نکرد. اگر مبلغی از حساب شما کم شده باشد، طبق روال بانکی تا ۷۲ ساعت
                    برمی‌گردد. برای پیگیری با پشتیبانی تماس بگیرید.
                </p>
                <p class="mt-2 text-small">
                    <span dir="ltr" class="latin">{ CONTACT.phone }</span>
                </p>
                <Button class="mt-5" onClick={ startOver }>
                    تلاش دوباره
                </Button>
            </Match>

            {/* Buying */}

            <Match when={ step === 'confirm' }>
                <h2 class="font-bold">شماره را تأیید کنید</h2>
                <p class="mt-2 text-small text-muted">
                    کد فقط به همین شماره پیامک می‌شود. یک بار بخوانیدش.
                </p>

                <div class="mt-5 rounded-xl border border-line bg-paper p-4">
                    <p class="text-caption text-muted">شمارهٔ موبایل</p>
                    <p dir="ltr" class="latin mt-1 text-start text-lg font-semibold">{ purchase.values().phone }</p>
                    <button
                        type="button"
                        class="mt-2 min-h-tap text-caption font-bold text-firouze hover:underline"
                        onClick={ () => { step = 'phone'; } }
                    >
                        ویرایش شماره
                    </button>
                </div>

                {/* The title is operator-typed, so its length is not ours to assume.
                    `min-w-0` lets it wrap instead of pushing the row off the panel. */}
                <dl class="mt-4 grid gap-2 text-small">
                    <div class="flex justify-between gap-2">
                        <dt class="shrink-0 text-muted">کارت</dt>
                        <dd class="min-w-0 text-end font-bold">{ props.tier?.title ?? '' }</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="shrink-0 text-muted">مبلغ قابل پرداخت</dt>
                        <dd class="min-w-0 text-end font-bold">{ toman(props.tier?.toman ?? 0) } تومان</dd>
                    </div>
                </dl>

                <Show when={ failure !== '' }>
                    <p class="mt-4 text-small text-danger">{ failure }</p>
                </Show>

                <Button
                    variant="primary"
                    full
                    trailing={ ArrowRight }
                    class="mt-5"
                    busy={ paying }
                    busyText="در حال انتقال به درگاه..."
                    disabled={ props.tier === undefined }
                    onClick={ () => void pay() }
                >
                    پرداخت { toman(props.tier?.toman ?? 0) } تومان
                </Button>

                <p class="mt-3 text-caption text-muted">
                    پرداخت روی درگاه زرین‌پال انجام می‌شود. اطلاعات کارت بانکی شما به سرور ما نمی‌رسد.
                </p>
            </Match>

            <Match when={ true }>
                <h2 class="font-bold">خرید { props.tier?.title ?? 'گیفت کارت' }</h2>
                <p class="mt-2 text-small text-muted">
                    شماره موبایلتان را وارد کنید. کد پس از پرداخت روی همین صفحه و با پیامک به این شماره می‌رسد.
                </p>

                <form class="mt-6" novalidate onSubmit={ purchase.handleSubmit }>
                    <Field
                        label="شماره موبایل"
                        for="phone"
                        error={ purchase.touched().phone && purchase.errors().phone ? 'شماره موبایل معتبر نیست. مثل ۰۹۱۷۰۴۵۹۳۳۰ بنویسید.' : '' }
                    >
                        <TextInput
                            id="phone"
                            type="tel"
                            latin
                            inputmode="tel"
                            autocomplete="tel"
                            placeholder="09170459330"
                            bind:value={ purchase.phone }
                        />
                    </Field>

                    <Button
                        type="submit"
                        variant="primary"
                        full
                        class="mt-5"
                        disabled={ props.tier === undefined || props.tier.available === 0 }
                    >
                        <Show when={ props.tier !== undefined && props.tier.available === 0 } fallback={ <span>ادامه</span> }>
                            <span>این کارت فعلاً موجود نیست</span>
                        </Show>
                    </Button>
                    <p class="mt-3 text-caption text-muted">
                        حسابی نمی‌سازید و رمزی تعیین نمی‌کنید. شماره فقط برای رساندن کد و پشتیبانی نگه داشته می‌شود.
                    </p>
                </form>
            </Match>
        </Switch>
    </div>
}
