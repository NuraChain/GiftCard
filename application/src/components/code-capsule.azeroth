// The page's signature motif. What a buyer actually receives is a string of
// characters that either works or does not, so the code IS the product and gets to be
// the hero rather than a stock card illustration. The `verified` variant is the only
// place the gold `nura` token is spent, which keeps its appearance meaningful.
//
// Every code shown on this page is a clearly labelled sample. Nothing here is a real
// redeemable code.
// The code carries dir="ltr": it isolates the Latin run so it cannot scramble the
// Persian layout around it, and keeps its own characters in reading order.
import { Check } from 'lucide';
import { icon } from '../ui/icon.ts';

export default component CodeCapsule(props: { code: string; label: string; verified?: boolean; scanning?: boolean })
{
    <div class="relative overflow-hidden rounded-xl border border-line bg-surface p-4 sm:p-5">
        <div class="flex items-center justify-between gap-3">
            <span class="text-caption text-muted">{ props.label }</span>
            <Show when={ props.verified }>
                <span class="flex items-center gap-1.5 text-caption font-bold text-nura">
                    { icon(Check, 'size-4') }
                    تأیید شد
                </span>
            </Show>
        </div>

        {/* `break-all` and a modest size are not styling preferences: a UUID is 36
            characters and the capsule sits in a one-third-width card, so anything larger
            overflows a container that has to clip for the scan sweep - and a clipped code
            is a code the buyer cannot read or copy. It wraps instead. */}
        <p class="mt-2 text-start text-base font-semibold break-all sm:text-lg">
            <span dir="ltr" class="latin inline-block">{ props.code }</span>
        </p>

        <Show when={ props.scanning }>
            <span
                class="anim-scan pointer-events-none absolute top-0 h-full w-1/4 bg-linear-to-r from-transparent via-firouze/25 to-transparent"
                aria-hidden="true"
            ></span>
        </Show>
    </div>
}
