// The phone navigation: a DISCLOSURE panel, deliberately not a modal drawer.
//
// The nav is three in-page anchors. A modal drawer would oblige a focus trap, a scroll lock,
// role="dialog"/aria-modal, and focus restoration - and a drawer that skips any of those is
// worse than no drawer, because it can strand a keyboard user inside it. A non-modal
// disclosure needs none of that machinery and cannot trap anyone. If this nav ever grows past
// ~5 items, promote it to a real modal and take on the full contract at that point.
//
// The theme control deliberately does NOT live in here: it sits beside the trigger in the
// header, so changing theme is one tap from anywhere instead of two. This panel holds
// navigation, which is the one thing it is for.
import { Menu, X } from 'lucide';

import { useCopy, type Lang } from '../lib/lang.ts';
import Icon from '../ui/icon.azeroth';

const COPY: Record<Lang, { open: string; close: string }> = {
    fa: { open: 'باز کردن منو', close: 'بستن منو' },
    en: { open: 'Open menu', close: 'Close menu' },
    ar: { open: 'فتح القائمة', close: 'إغلاق القائمة' },
    es: { open: 'Abrir menú', close: 'Cerrar menú' },
    pt: { open: 'Abrir menu', close: 'Fechar menu' },
    hi: { open: 'मेनू खोलें', close: 'मेनू बंद करें' },
    zh: { open: '打开菜单', close: '关闭菜单' },
    ru: { open: 'Открыть меню', close: 'Закрыть меню' },
    fr: { open: 'Ouvrir le menu', close: 'Fermer le menu' },
    tr: { open: 'Menüyü aç', close: 'Menüyü kapat' }
};

export interface MobileNavProps {
    links: Array<{ href: string; label: string }>;
}

export default component MobileNav(props: MobileNavProps)
{
    const t = useCopy(COPY);
    state open = false;

    // The trigger, so Escape can hand focus back to it. Losing focus to <body> on close is
    // the classic disclosure bug: the next Tab restarts from the top of the document instead
    // of continuing from the control you just used.
    let trigger: HTMLButtonElement | undefined;
    let panel: HTMLDivElement | undefined;

    effect (open) {
        if (!open) {
            return;
        }
        const onKey = (event: KeyboardEvent): void => {
            if (event.key === 'Escape') {
                open = false;
                trigger?.focus();
            }
        };
        // Armed one task late: the pointerdown that OPENED the panel is still propagating,
        // and a listener attached synchronously would see it and close the panel immediately.
        let onOutside: ((event: Event) => void) | undefined;
        const arm = setTimeout(() => {
            onOutside = (event: Event): void => {
                const target = event.target as Node | null;
                if (
                    target !== null &&
                    !(panel?.contains(target) ?? false) &&
                    !(trigger?.contains(target) ?? false)
                ) {
                    open = false;
                }
            };
            document.addEventListener('pointerdown', onOutside);
        }, 0);
        document.addEventListener('keydown', onKey);
        cleanup {
            clearTimeout(arm);
            document.removeEventListener('keydown', onKey);
            if (onOutside !== undefined) {
                document.removeEventListener('pointerdown', onOutside);
            }
        }
    }

    <div class="md:hidden">
        <button
            type="button"
            ref={ (element) => trigger = element }
            class="flex size-tap items-center justify-center rounded-xl border border-line text-ink"
            aria-expanded={ open ? 'true' : 'false' }
            aria-controls="mobile-nav-panel"
            aria-label={ open ? t.close : t.open }
            onClick={ () => open = !open }
        >
            <Show when={ open } fallback={ <Icon icon={ Menu } class="size-5" /> }>
                <Icon icon={ X } class="size-5" />
            </Show>
        </button>
        <Show when={ open }>
            <div
                id="mobile-nav-panel"
                ref={ (element) => panel = element }
                class="anim-settle absolute inset-x-0 top-full border-b border-line bg-paper p-3 shadow-lg"
            >
                <ul class="flex flex-col">
                    <For each={ props.links } key={ (link) => link.href } let={ link }>
                        <li>
                            <a
                                class="flex min-h-tap items-center rounded-xl px-3 text-small transition-colors hover:bg-surface hover:text-firouze"
                                href={ link.href }
                                onClick={ () => open = false }
                            >
                                { link.label }
                            </a>
                        </li>
                    </For>
                </ul>
            </div>
        </Show>
    </div>
}
