// Loading stock: paste a batch from the supplier, one code per line.
//
// The count of what WILL be submitted is on screen before the button is pressed. Nobody
// reads a pasted batch line by line, so a paste that silently lost half a supplier's list
// is only discoverable if the number is visible beforehand.
//
// `onAdded` is how the inventory table beside this form learns to refetch - the parent owns
// that, because a form should not know what else is on the page.
import { Plus } from 'lucide';

import { client } from '../../../lib/api.ts';
import type { TierRow } from '../../../../../server/src/schemas.ts';
import { count } from '../../../lib/format.ts';
import { icon } from '../../../ui/icon.ts';
import { useToasts } from '../../../ui/toast.ts';
import Button from '../../../ui/button.azeroth';
import Field from '../../../ui/field.azeroth';
import Select from '../../../ui/select.azeroth';

export default component PasteForm(props: { tiers: TierRow[]; onAdded: () => void })
{
    const notify = useToasts();

    state amount = 0;
    state paste = '';
    state pasting = false;
    state result: { added: number; duplicate: number; invalid: string[] } | null = null;

    derived options = props.tiers.map((tier) => ({ value: String(tier.amount), label: `$${ tier.amount } - ${ tier.title }` }));

    // Default to the recommended card, or the first one. There is no fixed set of
    // denominations any more, so there is no constant to default to.
    effect (props.tiers)
    {
        if (amount === 0 && props.tiers.length > 0)
        {
            amount = (props.tiers.find((tier) => tier.recommended) ?? props.tiers[0]).amount;
        }
    }

    /**
     * The lines a paste will actually submit. Counted BEFORE sending, because the whole
     * point of pasting a batch is that nobody reads it line by line - and a paste that
     * silently lost half a supplier's list is only discoverable if the count is on screen
     * before the button is pressed.
     */
    derived pastedLines = paste.split(/[\s,;]+/).filter((line) => line !== '');

    const submit = async (event: Event): Promise<void> =>
    {
        event.preventDefault();
        pasting = true;
        result = null;
        try
        {
            const added = await client.admin.addCodes({ input: { amount, codes: pastedLines } });
            result = added;
            paste = '';
            props.onAdded();
            if (added.added > 0)
            {
                notify.success(`${ count(added.added) } کد به موجودی $${ amount } افزوده شد`);
            }
            else
            {
                notify.info('هیچ کد تازه‌ای افزوده نشد');
            }
        }
        catch (failure)
        {
            notify.error(failure instanceof Error && failure.message !== '' ? failure.message : 'افزودن کدها انجام نشد');
        }
        finally
        {
            pasting = false;
        }
    };

    <section>
        <h2 class="flex items-center gap-2 text-h3 font-bold">
            { icon(Plus, 'size-5 text-firouze') }
            افزودن کد
        </h2>
        <p class="mt-2 text-small text-muted">
            کدها را از تأمین‌کننده بگیرید و اینجا بچسبانید؛ هر کد در یک خط. فقط شناسهٔ استاندارد
            <span dir="ltr" class="latin mx-1">UUID</span>
            پذیرفته می‌شود و کد تکراری دوباره ثبت نمی‌شود.
        </p>

        <form class="mt-4 rounded-2xl border border-line bg-surface p-5" novalidate onSubmit={ (event: Event) => void submit(event) }>
            {/* A picker rather than a row of chips: the catalogue is the operator's, so
                this list is as long as they have made it, and eight chips wrap. */}
            <Show
                when={ props.tiers.length > 0 }
                fallback={ <p class="text-small text-muted">ابتدا از تب تنظیمات یک کارت بسازید.</p> }
            >
                <Field label="مبلغ کارت" for="paste-amount">
                    <Select
                        id="paste-amount"
                        label="مبلغ کارتی که این کدها برای آن است"
                        value={ String(amount) }
                        options={ options }
                        onChange={ (chosen) => { amount = Number(chosen); } }
                    />
                </Field>
            </Show>

            <div class="mt-5 flex items-baseline justify-between gap-3">
                <label class="block text-small font-bold" for="codes">کدها</label>
                <p class="text-caption text-muted">
                    <Show when={ pastedLines.length > 0 } fallback={ <span>هر کد در یک خط</span> }>
                        <span>{ count(pastedLines.length) } کد آمادهٔ افزودن</span>
                    </Show>
                </p>
            </div>
            <textarea
                id="codes"
                dir="ltr"
                rows="6"
                spellcheck="false"
                class="latin mt-2 w-full rounded-xl border border-line bg-paper p-4 text-start text-small outline-none focus:border-firouze"
                placeholder="7f3c1e2a-9b04-4d68-a5c1-0e7b2d9f4a31"
                bind:value={ paste }
            ></textarea>

            {/* Each number on its own line. Run together with a separator, Persian
                digits merge into one another: "۴ · ۱ · ۱" reads as a single number,
                and this is the screen where a misread count means a mis-stocked shop. */}
            <Show when={ result !== null }>
                <dl class="mt-4 grid gap-1 rounded-xl border border-line bg-paper p-4 text-small">
                    <div class="flex justify-between gap-2">
                        <dt>افزوده شد</dt>
                        <dd class="font-bold text-firouze">{ count(result?.added ?? 0) }</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="text-muted">تکراری، نادیده گرفته شد</dt>
                        <dd>{ count(result?.duplicate ?? 0) }</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class={ (result?.invalid.length ?? 0) > 0 ? 'text-danger' : 'text-muted' }>نامعتبر</dt>
                        <dd class={ (result?.invalid.length ?? 0) > 0 ? 'font-bold text-danger' : '' }>
                            { count(result?.invalid.length ?? 0) }
                        </dd>
                    </div>
                    <Show when={ (result?.invalid.length ?? 0) > 0 }>
                        <div class="mt-2 border-t border-line pt-2">
                            <p class="text-caption text-danger">این خط‌ها ثبت نشدند:</p>
                            <ul dir="ltr" class="latin mt-1 text-start text-caption text-muted">
                                <For each={ result?.invalid ?? [] } key={ (line) => line }>
                                    { (line) => <li>{ line }</li> }
                                </For>
                            </ul>
                        </div>
                    </Show>
                </dl>
            </Show>

            <Button
                type="submit"
                variant="primary"
                class="mt-5"
                busy={ pasting }
                busyText="در حال افزودن..."
                disabled={ paste.trim() === '' || amount === 0 }
            >
                افزودن به موجودی
            </Button>
        </form>
    </section>
}
