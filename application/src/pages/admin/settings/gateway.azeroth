// Where the money goes and how the code gets delivered: the payment gateway and the SMS
// provider, both editable without a deploy.
//
// A SECRET IS NEVER SHOWN. The inputs start empty with a masked placeholder, and leaving one
// blank means "keep it" - so saving a template name cannot wipe a working API key. The
// server enforces that too; this component only has to not fight it.
//
// The merchant id is the one field on the page that changes WHERE THE MONEY GOES, so it is
// the one field that asks a second question before saving.
import { AlertTriangle, Save, Send } from 'lucide';

import { client } from '../../../lib/api.ts';
import type { SettingsView } from '../../../../../server/src/schemas.ts';
import { icon } from '../../../ui/icon.ts';
import { useToasts } from '../../../ui/toast.ts';
import { useCatalog } from '../../../lib/catalog.ts';
import Async from '../../../ui/async.azeroth';
import Button from '../../../ui/button.azeroth';
import Field from '../../../ui/field.azeroth';
import TextInput from '../../../ui/text-input.azeroth';
import { useAdminSession } from '../session.ts';

export default component GatewaySettings()
{
    const notify = useToasts();
    const session = useAdminSession();
    const catalog = useCatalog();

    state settings: SettingsView | null = null;
    state loading = false;
    state error = '';

    // Secrets start EMPTY, not pre-filled with the stored value: there is no stored value to
    // pre-fill with, because the server never sends one. Blank means "unchanged".
    state formAppName = '';
    state formBase = '';
    state formMerchantId = '';
    state formKavenegarKey = '';
    state formKavenegarTemplate = '';
    state formKavenegarBase = '';
    state saving = false;

    state testPhone = '';
    state testing = false;

    const load = async (): Promise<void> =>
    {
        loading = true;
        error = '';
        try
        {
            const view = await client.admin.settings();
            settings = view;
            formAppName = view.appName;
            formBase = view.zarinpalBase;
            formKavenegarTemplate = view.kavenegarTemplate;
            formKavenegarBase = view.kavenegarBase;
        }
        catch (failure)
        {
            error = failure instanceof Error && failure.message !== '' ? failure.message : 'تنظیمات خوانده نشد';
        }
        finally
        {
            loading = false;
        }
    };

    // Keyed on the session, not on mount - see the note in overview.azeroth.
    effect (session.revision())
    {
        if (session.unlocked())
        {
            void load();
        }
    }

    const save = async (event: Event): Promise<void> =>
    {
        event.preventDefault();
        // Changing the merchant id changes WHERE THE MONEY GOES. It is the one field on this
        // page that deserves a second question.
        if (formMerchantId !== '' && !confirm('شناسهٔ پذیرنده عوض می‌شود. از این پس پرداخت‌ها به حساب تازه می‌رود. مطمئنید؟'))
        {
            return;
        }
        saving = true;
        try
        {
            // Absent, not empty: an untouched secret input must not clear a working
            // credential, so a blank field is simply not sent.
            settings = await client.admin.saveSettings({
                input: {
                    appName: formAppName,
                    zarinpalBase: formBase,
                    kavenegarTemplate: formKavenegarTemplate,
                    kavenegarBase: formKavenegarBase,
                    merchantId: formMerchantId === '' ? undefined : formMerchantId,
                    kavenegarKey: formKavenegarKey === '' ? undefined : formKavenegarKey
                }
            });
            formMerchantId = '';
            formKavenegarKey = '';
            // The name appears in the tab title and on every page, so the shop is told to
            // re-read it rather than left showing the old one until a reload.
            void catalog.load();
            notify.success('تنظیمات ذخیره شد');
        }
        catch (failure)
        {
            notify.error(failure instanceof Error && failure.message !== '' ? failure.message : 'ذخیره نشد');
        }
        finally
        {
            saving = false;
        }
    };

    const sendTest = async (event: Event): Promise<void> =>
    {
        event.preventDefault();
        testing = true;
        try
        {
            const result = await client.admin.testSms({ input: { phone: testPhone } });
            if (result.ok)
            {
                notify.success('پیامک آزمایشی ارسال شد');
            }
            else
            {
                notify.error(`ارسال نشد: ${ result.reason }`);
            }
        }
        catch (failure)
        {
            notify.error(failure instanceof Error && failure.message !== '' ? failure.message : 'ارسال نشد');
        }
        finally
        {
            testing = false;
        }
    };

    <section class="mt-section">
        <h2 class="text-h3 font-bold">درگاه و پیامک</h2>

        <div class="mt-4">
            <Async
                loading={ loading && settings === null }
                error={ error }
                onRetry={ () => void load() }
                skeleton={ <div class="anim-pulse h-64 rounded-2xl border border-line bg-surface"></div> }
            >
                <p class="mb-4 flex items-start gap-2 rounded-xl border border-nura/40 bg-nura/10 p-4 text-small">
                    { icon(AlertTriangle, 'size-5 shrink-0 text-nura') }
                    <span>
                        تغییر شناسهٔ پذیرنده مقصد پول را عوض می‌کند. مقادیر محرمانه پس از ذخیره دیگر نمایش داده نمی‌شوند؛
                        برای نگه داشتن مقدار فعلی، کادر را خالی بگذارید.
                    </span>
                </p>

                <form class="rounded-2xl border border-line bg-surface p-5" novalidate onSubmit={ (event: Event) => void save(event) }>
                    <Field
                        label="نام فروشگاه"
                        for="app-name"
                        hint="روی عنوان مرورگر، سربرگ صفحه‌ها، پانویس، و توضیح تراکنش در درگاه دیده می‌شود."
                    >
                        <TextInput id="app-name" placeholder="نورا چین" bind:value={ formAppName } />
                    </Field>

                    <Field label="آدرس درگاه" for="zarinpal-base" class="mt-4">
                        <TextInput id="zarinpal-base" latin bind:value={ formBase } />
                    </Field>
                    <p class="mt-1 text-caption text-muted">
                        <Show
                            when={ settings?.sandbox }
                            fallback={ <span>درگاه واقعی. پرداخت‌ها با پول واقعی انجام می‌شود.</span> }
                        >
                            <span class="text-nura">حالت آزمایشی (سندباکس) - پولی جابه‌جا نمی‌شود.</span>
                        </Show>
                    </p>

                    <Field label="شناسهٔ پذیرنده" for="merchant-id" class="mt-4">
                        <TextInput
                            id="merchant-id"
                            latin
                            autocomplete="off"
                            placeholder={ settings?.merchantIdSet ? `${ settings.merchantIdMasked } (برای تغییر بنویسید)` : 'تنظیم نشده' }
                            bind:value={ formMerchantId }
                        />
                    </Field>

                    <Field label="کلید کاوه‌نگار" for="kavenegar-key" class="mt-4">
                        <TextInput
                            id="kavenegar-key"
                            type="password"
                            latin
                            autocomplete="off"
                            placeholder={ settings?.kavenegarKeySet ? `${ settings.kavenegarKeyMasked } (برای تغییر بنویسید)` : 'تنظیم نشده' }
                            bind:value={ formKavenegarKey }
                        />
                    </Field>

                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                        <Field label="نام قالب" for="kavenegar-template">
                            <TextInput id="kavenegar-template" latin bind:value={ formKavenegarTemplate } />
                        </Field>
                        <Field label="آدرس کاوه‌نگار" for="kavenegar-base">
                            <TextInput id="kavenegar-base" latin bind:value={ formKavenegarBase } />
                        </Field>
                    </div>

                    {/* A flex child defaults to `min-width: auto`, so an unbreakable
                        value refuses to shrink and pushes the row past the viewport -
                        which is exactly what this URL did. `min-w-0` is what lets it
                        shrink at all; `break-all` is what it does once it can. */}
                    <dl class="mt-5 grid gap-2 border-t border-line pt-4 text-caption text-muted">
                        <div class="flex justify-between gap-2">
                            <dt>وضعیت پیامک</dt>
                            <dd class={ settings?.smsReady ? 'font-bold text-firouze' : 'font-bold text-nura' }>
                                { settings?.smsReady ? 'آماده' : 'خاموش' }
                            </dd>
                        </div>
                        <div class="flex justify-between gap-2">
                            <dt class="shrink-0">آدرس بازگشت از درگاه</dt>
                            <dd dir="ltr" class="latin min-w-0 break-all text-end">{ settings?.callbackUrl ?? '' }</dd>
                        </div>
                    </dl>

                    <Button
                        type="submit"
                        variant="primary"
                        glyph={ Save }
                        class="mt-5"
                        busy={ saving }
                        busyText="در حال ذخیره..."
                    >
                        ذخیره تنظیمات
                    </Button>
                </form>

                {/* The only way to prove a Kavenegar template is approved without selling
                    something first. It sends an obviously-fake token, never a real code. */}
                <form class="mt-4 flex flex-wrap items-end gap-2 rounded-2xl border border-line bg-surface p-5" novalidate onSubmit={ (event: Event) => void sendTest(event) }>
                    <Field label="پیامک آزمایشی به" for="test-phone" class="min-w-0 flex-1">
                        <TextInput
                            id="test-phone"
                            type="tel"
                            latin
                            inputmode="tel"
                            placeholder="09170459330"
                            bind:value={ testPhone }
                        />
                    </Field>
                    <Button
                        type="submit"
                        glyph={ Send }
                        busy={ testing }
                        busyText="در حال ارسال..."
                        disabled={ testPhone === '' }
                    >
                        ارسال
                    </Button>
                </form>
            </Async>
        </div>
    </section>
}
