// Loading stock, and auditing where it went.
//
// Adding and inspecting live on one tab because they are one job: you paste a batch, then
// you check it landed. The inventory table below is the receipt for the form above it.
//
// Codes stay MASKED until asked for. A console that prints the whole inventory is one
// screenshot away from giving it away, and these are bearer values - whoever reads one can
// redeem it.
import { Copy, Plus, Search, Ticket } from 'lucide';

import { client } from '../../api.ts';
import type { CodeRow, TierRow } from '../../../../server/src/contract.ts';
import { count, moment } from '../../format.ts';
import { icon } from '../../components/icon.ts';
import { useToasts } from '../../components/toast.ts';
import Async from '../../components/async.azeroth';
import Button from '../../components/ui/button.azeroth';
import Field from '../../components/ui/field.azeroth';
import Select from '../../components/ui/select.azeroth';
import TextInput from '../../components/ui/text-input.azeroth';
import AdminShell from './shell.azeroth';
import { useAdminSession } from './session.ts';

/**
 * The inventory filters, in the order an operator asks the questions. The first entry
 * names the filter as well as clearing it, which is what lets the picker go unlabelled.
 */
const FILTERS: Array<{ label: string; state: 'free' | 'held' | 'sold' | null }> =
[
    { label: 'همهٔ وضعیت‌ها', state: null },
    { label: 'آماده فروش', state: 'free' },
    { label: 'رزرو شده', state: 'held' },
    { label: 'فروخته شده', state: 'sold' }
];

/** Persian for a code's state, with the token that carries its weight. */
const STATE_TEXT: Record<string, { label: string; tone: string }> =
{
    free: { label: 'آماده فروش', tone: 'text-firouze' },
    held: { label: 'رزرو شده', tone: 'text-nura' },
    sold: { label: 'فروخته شده', tone: 'text-muted' }
};

export default component Codes()
{
    const notify = useToasts();
    const session = useAdminSession();

    state tiers: TierRow[] = [];
    state pasteAmount = 0;
    state paste = '';
    state pasting = false;
    state pasteResult: { added: number; duplicate: number; invalid: string[] } | null = null;

    state rows: CodeRow[] = [];
    state total = 0;
    state pageSize = 25;
    state page = 1;
    state search = '';
    state filterState: 'free' | 'held' | 'sold' | null = null;
    state filterAmount: number | null = null;
    state loading = false;
    state error = '';
    state revealed: string | null = null;

    derived lastPage = Math.max(1, Math.ceil(total / pageSize));

    derived stateOptions = FILTERS.map((item) => ({ value: item.state ?? '', label: item.label }));
    // Rebuilt from the catalogue rather than fixed: the denominations are the operator's to
    // change, so this list is however many cards they have defined today.
    derived amountOptions = [
        { value: '', label: 'هر مبلغی' },
        ...tiers.map((tier) => ({ value: String(tier.amount), label: `$${ tier.amount }`, latin: true }))
    ];
    derived pasteOptions = tiers.map((tier) => ({ value: String(tier.amount), label: `$${ tier.amount } - ${ tier.title }` }));

    /**
     * The lines a paste will actually submit. Counted BEFORE sending, because the whole
     * point of pasting a batch is that nobody reads it line by line - and a paste that
     * silently lost half a supplier's list is only discoverable if the count is on screen
     * before the button is pressed.
     */
    derived pastedLines = paste.split(/[\s,;]+/).filter((line) => line !== '');

    const loadCodes = async (): Promise<void> =>
    {
        loading = true;
        error = '';
        try
        {
            const found = await client.admin.codes({
                query: {
                    search,
                    state: filterState ?? undefined,
                    amount: filterAmount ?? undefined,
                    page
                }
            });
            rows = found.rows;
            total = found.total;
            pageSize = found.pageSize;
        }
        catch (failure)
        {
            error = failure instanceof Error && failure.message !== '' ? failure.message : 'کدها خوانده نشدند';
        }
        finally
        {
            loading = false;
        }
    };

    const loadTiers = async (): Promise<void> =>
    {
        try
        {
            const found = await client.admin.tiers();
            tiers = found.tiers;
            // Default to the recommended card, or the first one. There is no fixed set of
            // denominations any more, so there is no constant to default to.
            if (pasteAmount === 0 && tiers.length > 0)
            {
                pasteAmount = (tiers.find((tier) => tier.recommended) ?? tiers[0]).amount;
            }
        }
        catch
        {
            // The paste form needs a denomination to be useful; the table below does not.
            // A tier failure is reported by the table's own error state on retry.
        }
    };

    // Keyed on the session, not on mount - see the note in overview.azeroth.
    effect (session.revision())
    {
        if (session.unlocked())
        {
            void loadTiers();
            void loadCodes();
        }
    }

    /** Any change to a filter is a new question, so it starts at page one. */
    const filter = async (change: () => void): Promise<void> =>
    {
        change();
        page = 1;
        await loadCodes();
    };

    const goToPage = async (next: number): Promise<void> =>
    {
        page = Math.min(Math.max(1, next), lastPage);
        await loadCodes();
    };

    const addCodes = async (event: Event): Promise<void> =>
    {
        event.preventDefault();
        pasting = true;
        pasteResult = null;
        try
        {
            const result = await client.admin.addCodes({ input: { amount: pasteAmount, codes: pastedLines } });
            pasteResult = result;
            paste = '';
            await loadCodes();
            if (result.added > 0)
            {
                notify.success(`${ count(result.added) } کد به موجودی $${ pasteAmount } افزوده شد`);
            }
            else
            {
                notify.info('هیچ کد تازه‌ای افزوده نشد');
            }
        }
        catch (failure)
        {
            notify.error(failure instanceof Error && failure.message !== '' ? failure.message : 'افزودن کدها انجام نشد');
        }
        finally
        {
            pasting = false;
        }
    };

    /**
     * The clipboard leaves no trace on the page, so this is the one console action that
     * cannot confirm itself. Support reads or pastes a code far more often than it retypes one.
     */
    const copyCode = async (code: string): Promise<void> =>
    {
        try
        {
            await navigator.clipboard.writeText(code);
            notify.success('کد کپی شد');
        }
        catch
        {
            notify.error('کپی نشد. کد را دستی انتخاب کنید.');
        }
    };

    <AdminShell>
        <section>
            <h2 class="flex items-center gap-2 text-h3 font-bold">
                { icon(Plus, 'size-5 text-firouze') }
                افزودن کد
            </h2>
            <p class="mt-2 text-small text-muted">
                کدها را از تأمین‌کننده بگیرید و اینجا بچسبانید؛ هر کد در یک خط. فقط شناسهٔ استاندارد
                <span dir="ltr" class="latin mx-1">UUID</span>
                پذیرفته می‌شود و کد تکراری دوباره ثبت نمی‌شود.
            </p>

            <form class="mt-4 rounded-2xl border border-line bg-surface p-5" novalidate onSubmit={ (event: Event) => void addCodes(event) }>
                {/* A picker rather than a row of chips: the catalogue is the operator's, so
                    this list is as long as they have made it, and eight chips wrap. */}
                <Show
                    when={ tiers.length > 0 }
                    fallback={ <p class="text-small text-muted">ابتدا از تب تنظیمات یک کارت بسازید.</p> }
                >
                    <Field label="مبلغ کارت" for="paste-amount">
                        <Select
                            id="paste-amount"
                            label="مبلغ کارتی که این کدها برای آن است"
                            value={ String(pasteAmount) }
                            options={ pasteOptions }
                            onChange={ (chosen) => { pasteAmount = Number(chosen); } }
                        />
                    </Field>
                </Show>

                <div class="mt-5 flex items-baseline justify-between gap-3">
                    <label class="block text-small font-bold" for="codes">کدها</label>
                    <p class="text-caption text-muted">
                        <Show when={ pastedLines.length > 0 } fallback={ <span>هر کد در یک خط</span> }>
                            <span>{ count(pastedLines.length) } کد آمادهٔ افزودن</span>
                        </Show>
                    </p>
                </div>
                <textarea
                    id="codes"
                    dir="ltr"
                    rows="6"
                    spellcheck="false"
                    class="latin mt-2 w-full rounded-xl border border-line bg-paper p-4 text-start text-small outline-none focus:border-firouze"
                    placeholder="7f3c1e2a-9b04-4d68-a5c1-0e7b2d9f4a31"
                    bind:value={ paste }
                ></textarea>

                {/* Each number on its own line. Run together with a separator, Persian
                    digits merge into one another: "۴ · ۱ · ۱" reads as a single number,
                    and this is the screen where a misread count means a mis-stocked shop. */}
                <Show when={ pasteResult !== null }>
                    <dl class="mt-4 grid gap-1 rounded-xl border border-line bg-paper p-4 text-small">
                        <div class="flex justify-between gap-2">
                            <dt>افزوده شد</dt>
                            <dd class="font-bold text-firouze">{ count(pasteResult?.added ?? 0) }</dd>
                        </div>
                        <div class="flex justify-between gap-2">
                            <dt class="text-muted">تکراری، نادیده گرفته شد</dt>
                            <dd>{ count(pasteResult?.duplicate ?? 0) }</dd>
                        </div>
                        <div class="flex justify-between gap-2">
                            <dt class={ (pasteResult?.invalid.length ?? 0) > 0 ? 'text-danger' : 'text-muted' }>نامعتبر</dt>
                            <dd class={ (pasteResult?.invalid.length ?? 0) > 0 ? 'font-bold text-danger' : '' }>
                                { count(pasteResult?.invalid.length ?? 0) }
                            </dd>
                        </div>
                        <Show when={ (pasteResult?.invalid.length ?? 0) > 0 }>
                            <div class="mt-2 border-t border-line pt-2">
                                <p class="text-caption text-danger">این خط‌ها ثبت نشدند:</p>
                                <ul dir="ltr" class="latin mt-1 text-start text-caption text-muted">
                                    <For each={ pasteResult?.invalid ?? [] } key={ (line) => line }>
                                        { (line) => <li>{ line }</li> }
                                    </For>
                                </ul>
                            </div>
                        </Show>
                    </dl>
                </Show>

                <Button
                    type="submit"
                    variant="primary"
                    class="mt-5"
                    busy={ pasting }
                    busyText="در حال افزودن..."
                    disabled={ paste.trim() === '' || pasteAmount === 0 }
                >
                    افزودن به موجودی
                </Button>
            </form>
        </section>

        <section class="mt-section">
            <h2 class="flex items-center gap-2 text-h3 font-bold">
                { icon(Ticket, 'size-5 text-firouze') }
                موجودی
            </h2>
            <p class="mt-2 text-small text-muted">
                هر کدی که وارد کرده‌اید، به‌همراه وضعیت و خریدارش. تازه‌ترین کد اول.
            </p>

            <form class="mt-4 flex flex-wrap gap-2" novalidate onSubmit={ (event: Event) => { event.preventDefault(); void filter(() => undefined); } }>
                <label class="sr-only" for="code-search">جستجو در کدها</label>
                <div class="relative min-w-0 flex-1">
                    <TextInput
                        id="code-search"
                        tone="surface"
                        class="ps-11 pe-4 text-small"
                        placeholder="بخشی از کد، یا شماره موبایل خریدار"
                        bind:value={ search }
                    />
                    <span class="pointer-events-none absolute inset-y-0 start-4 flex items-center text-muted">
                        { icon(Search, 'size-4') }
                    </span>
                </div>
                <Button type="submit" disabled={ loading }>جستجو</Button>
            </form>

            {/* Pickers, not chips. As chips these two filters wrapped onto three rows of a
                phone, and they grow with the catalogue - a shop with eight denominations
                would have had eleven buttons here. A picker is one row at any catalogue
                size, and on a phone it opens the platform's own list.

                Neither carries a visible label: the option that clears the filter also
                names it, so "همهٔ وضعیت‌ها" says what the closed picker is for. */}
            <div class="mt-3 flex gap-2">
                <Select
                    id="filter-state"
                    class="min-w-0 flex-1 sm:max-w-52"
                    label="وضعیت کد"
                    value={ filterState ?? '' }
                    options={ stateOptions }
                    onChange={ (chosen) => void filter(() => { filterState = chosen === '' ? null : chosen as 'free' | 'held' | 'sold'; }) }
                />
                <Select
                    id="filter-amount"
                    class="min-w-0 flex-1 sm:max-w-40"
                    label="مبلغ کارت"
                    value={ filterAmount === null ? '' : String(filterAmount) }
                    options={ amountOptions }
                    onChange={ (chosen) => void filter(() => { filterAmount = chosen === '' ? null : Number(chosen); }) }
                />
            </div>

            <div class="mt-4">
                <Async
                    loading={ loading }
                    error={ error }
                    empty={ rows.length === 0 }
                    emptyText={ search === '' && filterState === null && filterAmount === null ? 'هنوز کدی وارد نشده است.' : 'کدی با این مشخصات نیست.' }
                    onRetry={ () => void loadCodes() }
                    skeleton={ <div class="anim-pulse h-64 rounded-2xl border border-line bg-surface"></div> }
                >
                    {/* Cards below `md` - see the note on the same table in orders.azeroth.
                        The reveal sits at the FOOT of each card rather than the head: the code
                        is masked, so what identifies a row on sight is its state and amount,
                        and leading with the button would make the page a stack of buttons. */}
                    <div class="overflow-x-auto rounded-2xl border border-line bg-surface">
                        <table class="table-cards w-full text-start text-small">
                            <thead class="border-b border-line text-caption text-muted">
                                <tr>
                                    <th class="p-3 text-start font-normal">کد</th>
                                    <th class="p-3 text-start font-normal">کارت</th>
                                    <th class="p-3 text-start font-normal">وضعیت</th>
                                    <th class="p-3 text-start font-normal">خریدار</th>
                                    <th class="p-3 text-start font-normal">افزوده شد</th>
                                    <th class="p-3 text-start font-normal">فروخته شد</th>
                                </tr>
                            </thead>
                            <tbody>
                                <For each={ rows } key={ (row) => `${ row.code }:${ row.state }` }>
                                    { (row) =>
                                        <tr class="border-b border-line/60">
                                            <td data-label="کد" class="cell-action p-3 whitespace-nowrap max-md:order-6">
                                                <Show
                                                    when={ revealed === row.code }
                                                    fallback={
                                                        <button
                                                            type="button"
                                                            class="py-1 text-caption font-bold text-firouze hover:underline max-md:min-h-tap max-md:w-full max-md:rounded-xl max-md:border max-md:border-line"
                                                            onClick={ () => { revealed = row.code; } }
                                                        >
                                                            نمایش کد
                                                        </button>
                                                    }
                                                >
                                                    <button
                                                        type="button"
                                                        class="flex items-center gap-2 py-1 text-caption hover:text-firouze max-md:min-h-tap max-md:w-full max-md:justify-center max-md:rounded-xl max-md:border max-md:border-line max-md:px-3"
                                                        title="کپی کردن کد"
                                                        onClick={ () => void copyCode(row.code) }
                                                    >
                                                        <span dir="ltr" class="latin break-all">{ row.code }</span>
                                                        { icon(Copy, 'size-3.5 shrink-0 text-muted') }
                                                    </button>
                                                </Show>
                                            </td>
                                            <td data-label="کارت" class="cell-inline p-3 whitespace-nowrap max-md:order-2">
                                                <span dir="ltr" class="latin">${ row.amount }</span>
                                            </td>
                                            <td data-label="وضعیت" class={ `cell-inline p-3 whitespace-nowrap font-bold max-md:order-1 ${ STATE_TEXT[row.state].tone }` }>
                                                { STATE_TEXT[row.state].label }
                                            </td>
                                            <td data-label="خریدار" class="cell-inline p-3 whitespace-nowrap max-md:order-3">
                                                <Show when={ row.phone !== null } fallback={ <span class="text-muted">-</span> }>
                                                    <span dir="ltr" class="latin">{ row.phone ?? '' }</span>
                                                </Show>
                                            </td>
                                            <td data-label="افزوده شد" class="cell-inline p-3 whitespace-nowrap text-caption text-muted max-md:order-4">{ moment(row.addedAt) }</td>
                                            <td data-label="فروخته شد" class="cell-inline p-3 whitespace-nowrap text-caption text-muted max-md:order-5">
                                                { row.soldAt === null ? '-' : moment(row.soldAt) }
                                            </td>
                                        </tr>
                                    }
                                </For>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 flex flex-wrap items-center gap-3">
                        <p class="text-caption text-muted">
                            { count(total) } کد، صفحهٔ { count(page) } از { count(lastPage) }
                        </p>
                        <div class="ms-auto flex gap-2">
                            <Button disabled={ page <= 1 || loading } onClick={ () => void goToPage(page - 1) }>تازه‌تر</Button>
                            <Button disabled={ page >= lastPage || loading } onClick={ () => void goToPage(page + 1) }>قدیمی‌تر</Button>
                        </div>
                    </div>
                </Async>
            </div>
        </section>
    </AdminShell>
}
