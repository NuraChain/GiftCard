// The first question of the day: can I trade?
//
// The available count per denomination is the largest type on the page because it is the
// number that decides that. Everything else here is context for it.
import { RefreshCw, TriangleAlert } from 'lucide';

import { client } from '../../lib/api.ts';
import type { AdminOverview } from '../../../../server/src/contract/index.ts';
import { count } from '../../lib/format.ts';
import { icon } from '../../ui/icon.ts';
import { useToasts } from '../../ui/toast.ts';
import Async from '../../ui/async.azeroth';
import Button from '../../ui/button.azeroth';
import AdminShell from './shell.azeroth';
import { useAdminSession } from './session.ts';

export default component Overview()
{
    const notify = useToasts();
    const session = useAdminSession();

    state data: AdminOverview | null = null;
    state loading = false;
    state error = '';

    const load = async (announce = false): Promise<void> =>
    {
        loading = true;
        error = '';
        try
        {
            data = await client.admin.overview();
            if (announce)
            {
                // Refreshing usually changes nothing on screen, so without a notice the
                // click looks like it did nothing at all.
                notify.success('اطلاعات به‌روز شد');
            }
        }
        catch (failure)
        {
            error = failure instanceof Error && failure.message !== '' ? failure.message : 'اطلاعات خوانده نشد';
        }
        finally
        {
            loading = false;
        }
    };

    // Keyed on the session rather than on mount: this component's markup is built when the
    // ROUTE renders, which is before anyone has signed in, so a mount-time fetch 401s against
    // the lock screen and never retries. Watching the session means the tab fills itself the
    // moment sign-in succeeds - and again after a re-authentication.
    effect (session.revision())
    {
        if (session.unlocked())
        {
            void load();
        }
    }

    <AdminShell>
        <div class="flex items-center gap-3">
            <h2 class="text-h3 font-bold">موجودی کدها</h2>
            <Button glyph={ RefreshCw } compact class="ms-auto" disabled={ loading } onClick={ () => void load(true) }>
                تازه‌سازی
            </Button>
        </div>

        <Show when={ (data?.owed ?? 0) > 0 }>
            <p class="mt-5 flex items-center gap-2 rounded-xl border border-danger/40 bg-danger/10 p-4 text-small font-bold text-danger">
                { icon(TriangleAlert, 'size-5 shrink-0') }
                { count(data?.owed ?? 0) } سفارش پرداخت‌شده بدون کد مانده است. در تب سفارش‌ها بالای جدول آمده‌اند.
            </p>
        </Show>

        <div class="mt-5">
            <Async
                loading={ loading && data === null }
                error={ error }
                empty={ data !== null && data.stock.length === 0 }
                emptyText="هنوز کارتی تعریف نشده است. از تب تنظیمات یکی بسازید."
                onRetry={ () => void load() }
                skeleton={
                    <div class="grid grid-cols-3 gap-2 sm:gap-4">
                        <div class="anim-pulse h-24 rounded-2xl border border-line bg-surface sm:h-40"></div>
                        <div class="anim-pulse h-24 rounded-2xl border border-line bg-surface sm:h-40"></div>
                        <div class="anim-pulse h-24 rounded-2xl border border-line bg-surface sm:h-40"></div>
                    </div>
                }
            >
                {/* Three across at every width. Stacked, three numbers cost a whole phone
                    screen - and "can I trade today" is a question that should cost a glance.
                    The supporting lines go `sr-only` rather than `hidden` below `sm`: they
                    are still read out, they just stop taking space. */}
                <ul class="stagger grid grid-cols-3 gap-2 sm:gap-4">
                    <For each={ data?.stock ?? [] } key={ (line) => line.amount }>
                        { (line) =>
                            <li class="rounded-2xl border border-line bg-surface p-3 text-center sm:p-5 sm:text-start">
                                <p class="text-caption text-muted sm:text-small">
                                    <span class="max-sm:sr-only">کارت </span>
                                    <span dir="ltr" class="latin inline-block">${ line.amount }</span>
                                </p>
                                {/* Zero is a state, not a quantity - and the Persian zero is a
                                    single dot, which at any size reads as a speck rather than
                                    as "you cannot sell this today". So it is a word. */}
                                <Show
                                    when={ line.available > 0 }
                                    fallback={
                                        <div>
                                            <p class="mt-1 text-base font-bold text-danger sm:mt-2 sm:text-2xl">ناموجود</p>
                                            <p class="mt-1 text-caption text-danger max-sm:sr-only">کدی برای فروش نمانده است</p>
                                        </div>
                                    }
                                >
                                    <p class="mt-1 text-2xl font-bold text-firouze sm:mt-2 sm:text-4xl">{ count(line.available) }</p>
                                    <p class="mt-1 text-caption text-muted max-sm:sr-only">کد آماده فروش</p>
                                </Show>
                                {/* Two counts on two lines. Persian digits beside a middot read
                                    as one number: "۱ · ۱" is indistinguishable from "۱۰۱". */}
                                <dl class="mt-4 grid gap-1 text-caption text-muted max-sm:sr-only">
                                    <div class="flex justify-between gap-2">
                                        <dt>رزرو شده</dt>
                                        <dd>{ count(line.held) }</dd>
                                    </div>
                                    <div class="flex justify-between gap-2">
                                        <dt>فروخته شده</dt>
                                        <dd>{ count(line.sold) }</dd>
                                    </div>
                                </dl>
                            </li>
                        }
                    </For>
                </ul>
            </Async>
        </div>
    </AdminShell>
}
