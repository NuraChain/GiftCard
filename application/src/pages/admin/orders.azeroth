// The ledger: who bought what, and what they got.
//
// Owed rows - money verified, no code delivered - are pinned to the top by the server,
// because they are the only rows that need a human rather than a glance.
import { Search } from 'lucide';

import { client } from '../../lib/api.ts';
import type { LedgerRow } from '../../../../server/src/schemas.ts';
import { count, moment, toman } from '../../lib/format.ts';
import { icon } from '../../ui/icon.ts';
import { useToasts } from '../../ui/toast.ts';
import Async from '../../ui/async.azeroth';
import Button from '../../ui/button.azeroth';
import TextInput from '../../ui/text-input.azeroth';
import AdminShell from './shell.azeroth';
import { useAdminSession } from './session.ts';

/** Persian for each state, plus the token colour that carries its weight. */
const STATUS_TEXT: Record<string, { label: string; tone: string }> =
{
    pending: { label: 'در انتظار پرداخت', tone: 'text-muted' },
    paid: { label: 'پرداخت شده', tone: 'text-firouze' },
    cancelled: { label: 'لغو شده', tone: 'text-muted' },
    failed: { label: 'ناموفق', tone: 'text-danger' }
};

export default component Orders()
{
    const notify = useToasts();
    const session = useAdminSession();

    state rows: LedgerRow[] = [];
    state total = 0;
    state pageSize = 25;
    state page = 1;
    state search = '';
    state loading = false;
    state error = '';
    state revealed: string | null = null;

    derived lastPage = Math.max(1, Math.ceil(total / pageSize));

    const load = async (): Promise<void> =>
    {
        loading = true;
        error = '';
        try
        {
            const found = await client.admin.orders({ query: { search, page } });
            rows = found.rows;
            total = found.total;
            pageSize = found.pageSize;
        }
        catch (failure)
        {
            error = failure instanceof Error && failure.message !== '' ? failure.message : 'سفارش‌ها خوانده نشدند';
        }
        finally
        {
            loading = false;
        }
    };

    // Keyed on the session, not on mount - see the note in overview.azeroth.
    effect (session.revision())
    {
        if (session.unlocked())
        {
            void load();
        }
    }

    const runSearch = async (event: Event): Promise<void> =>
    {
        event.preventDefault();
        // A new search always starts at the beginning; staying on page 4 of the previous
        // result set is how an operator concludes there are no matches when there are.
        page = 1;
        await load();
    };

    const goToPage = async (next: number): Promise<void> =>
    {
        page = Math.min(Math.max(1, next), lastPage);
        await load();
    };

    const copyCode = async (code: string): Promise<void> =>
    {
        try
        {
            await navigator.clipboard.writeText(code);
            notify.success('کد کپی شد');
        }
        catch
        {
            notify.error('کپی نشد. کد را دستی انتخاب کنید.');
        }
    };

    <AdminShell>
        <h2 class="text-h3 font-bold">سفارش‌ها</h2>
        <p class="mt-2 text-small text-muted">
            ردیف‌های پرداخت‌شدهٔ بدون کد اول می‌آیند، بقیه از تازه به قدیم.
        </p>

        {/* One box, not four. Someone on a support call has the customer's number, or a
            code, or a reference - and should not have to know which field the system files
            it under. A partial number works: 0917، ۰۹۱۷ و 917 هر سه همان شماره را پیدا می‌کنند. */}
        <form class="mt-4 flex flex-wrap gap-2" novalidate onSubmit={ (event: Event) => void runSearch(event) }>
            <label class="sr-only" for="ledger-search">جستجو در سفارش‌ها</label>
            <div class="relative min-w-0 flex-1">
                <TextInput
                    id="ledger-search"
                    tone="surface"
                    class="ps-11 pe-4 text-small"
                    placeholder="شماره موبایل، کد، یا شمارهٔ پیگیری"
                    bind:value={ search }
                />
                <span class="pointer-events-none absolute inset-y-0 start-4 flex items-center text-muted">
                    { icon(Search, 'size-4') }
                </span>
            </div>
            <Button type="submit" disabled={ loading }>جستجو</Button>
            <Show when={ search !== '' }>
                <Button variant="ghost" onClick={ () => { search = ''; page = 1; void load(); } }>پاک کردن</Button>
            </Show>
        </form>

        <div class="mt-4">
            <Async
                loading={ loading }
                error={ error }
                empty={ rows.length === 0 }
                emptyText={ search === '' ? 'هنوز سفارشی ثبت نشده است.' : 'سفارشی با این مشخصات پیدا نشد.' }
                onRetry={ () => void load() }
                skeleton={ <div class="anim-pulse h-64 rounded-2xl border border-line bg-surface"></div> }
            >
                {/* `table-cards` redraws these rows as stacked cards below `md`. On a phone
                    the table was 566px wide in a 311px window: status, amount, reference and
                    code - the four a support call asks for - were all past the right edge. */}
                <div class="overflow-x-auto rounded-2xl border border-line bg-surface">
                    <table class="table-cards w-full text-start text-small">
                        <thead class="border-b border-line text-caption text-muted">
                            <tr>
                                <th class="p-3 text-start font-normal">زمان</th>
                                <th class="p-3 text-start font-normal">موبایل</th>
                                <th class="p-3 text-start font-normal">کارت</th>
                                <th class="p-3 text-start font-normal">مبلغ</th>
                                <th class="p-3 text-start font-normal">وضعیت</th>
                                <th class="p-3 text-start font-normal">پیگیری</th>
                                <th class="p-3 text-start font-normal">کد</th>
                            </tr>
                        </thead>
                        <tbody>
                            {/* The key carries the mutable part of the row, not just its
                                identity: `<For>` reuses a row whose key is unchanged, so
                                keying on the id alone would leave a settled order showing
                                "در انتظار پرداخت" after a refresh. */}
                            <For each={ rows } key={ (order) => `${ order.id }:${ order.status }:${ order.code ?? '' }:${ order.smsDelivered }` }>
                                { (order) =>
                                    <tr class={ `border-b border-line/60 ${ order.status === 'paid' && order.code === null ? 'bg-danger/5' : '' }` }>
                                        <td data-label="زمان" class="cell-inline p-3 whitespace-nowrap text-caption text-muted max-md:order-6">{ moment(order.createdAt) }</td>
                                        <td data-label="موبایل" class="p-3 whitespace-nowrap max-md:order-1 max-md:font-bold">
                                            <span dir="ltr" class="latin">{ order.phone }</span>
                                        </td>
                                        <td data-label="کارت" class="cell-inline p-3 whitespace-nowrap max-md:order-3">
                                            <span dir="ltr" class="latin">${ order.amount }</span>
                                        </td>
                                        <td data-label="مبلغ" class="cell-inline p-3 whitespace-nowrap text-caption max-md:order-4">{ toman(order.toman) }</td>
                                        <td data-label="وضعیت" class={ `cell-inline p-3 whitespace-nowrap font-bold max-md:order-2 ${ STATUS_TEXT[order.status]?.tone ?? '' }` }>
                                            { STATUS_TEXT[order.status]?.label ?? order.status }
                                            <Show when={ order.status === 'paid' && !order.smsDelivered && order.code !== null }>
                                                <span class="block text-caption font-normal text-muted">پیامک نرفت</span>
                                            </Show>
                                        </td>
                                        <td data-label="پیگیری" class="cell-inline p-3 whitespace-nowrap text-caption text-muted max-md:order-5">
                                            <span dir="ltr" class="latin">{ order.refId === null ? '-' : String(order.refId) }</span>
                                        </td>
                                        {/* `cell-action` only when there IS a code: the other two
                                            branches are values, and a value wants its label. */}
                                        <td data-label="کد" class={ `p-3 whitespace-nowrap max-md:order-7 ${ order.code === null ? '' : 'cell-action' }` }>
                                            <Switch>
                                                <Match when={ order.status === 'paid' && order.code === null }>
                                                    <span class="font-bold text-danger">کد داده نشده</span>
                                                </Match>
                                                <Match when={ order.code === null }>
                                                    <span class="text-muted">-</span>
                                                </Match>
                                                <Match when={ revealed === order.id }>
                                                    <button
                                                        type="button"
                                                        class="py-1 text-caption break-all hover:text-firouze max-md:min-h-tap max-md:w-full max-md:rounded-xl max-md:border max-md:border-line max-md:px-3"
                                                        title="کپی کردن کد"
                                                        onClick={ () => void copyCode(order.code ?? '') }
                                                    >
                                                        <span dir="ltr" class="latin">{ order.code }</span>
                                                    </button>
                                                </Match>
                                                <Match when={ true }>
                                                    <button
                                                        type="button"
                                                        class="py-1 text-caption font-bold text-firouze hover:underline max-md:min-h-tap max-md:w-full max-md:rounded-xl max-md:border max-md:border-line"
                                                        onClick={ () => { revealed = order.id; } }
                                                    >
                                                        نمایش کد
                                                    </button>
                                                </Match>
                                            </Switch>
                                        </td>
                                    </tr>
                                }
                            </For>
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-3">
                    {/* Word, comma, word - never digit-separator-digit. Persian numerals
                        beside a middot or a bare space read as one longer number. */}
                    <p class="text-caption text-muted">
                        { count(total) } سفارش، صفحهٔ { count(page) } از { count(lastPage) }
                    </p>
                    <div class="ms-auto flex gap-2">
                        <Button disabled={ page <= 1 || loading } onClick={ () => void goToPage(page - 1) }>تازه‌تر</Button>
                        <Button disabled={ page >= lastPage || loading } onClick={ () => void goToPage(page + 1) }>قدیمی‌تر</Button>
                    </div>
                </div>
            </Async>
        </div>
    </AdminShell>
}
