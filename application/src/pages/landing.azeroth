export default component Landing()
{
    const catalog = useCatalog();
    const lang = useLang();
    const t = useCopy(COPY);
    const name = useShopName();
    const faqs = FAQS[lang];

    // The hero capsule resolves from scanning to verified once, on load.
    state scanning = true;
    state verified = false;

    mount {
        const timer = setTimeout(() => {
            batch {
                scanning = false;
                verified = true;
            }
        }, 4200);
        cleanup { clearTimeout(timer); }
    }

    state openFaq: string | null = faqs[0].id;
    const toggleFaq = (id: string): void => {
        openFaq = openFaq === id ? null : id;
    };

    <div>
        <PurchaseResult />

        <section class="mx-auto grid max-w-6xl items-center gap-stack px-4 pt-section pb-stack sm:px-5 lg:grid-cols-[1.05fr_1fr]">
            <div class="anim-settle">
                { /* The name in the READER'S language: a Persian brand in front of "gift cards"
                     on an English page reads as a broken page, not as a brand. */ }
                <p class="text-small font-bold text-firouze">{ t.kicker(name()) }</p>
                <h1 class="mt-4 font-bold">{ t.headline }</h1>
                <p class="mt-5 max-w-xl text-muted">{ t.lede }</p>

                <div class="mt-stack flex flex-wrap gap-3">
                    <a
                        href="#cards"
                        class="flex min-h-tap items-center rounded-xl bg-firouze px-5 text-small font-bold text-paper hover:opacity-90"
                    >
                        { t.seeCards }
                    </a>
                    <a
                        href="#how"
                        class="flex min-h-tap items-center rounded-xl border border-line px-5 text-small font-bold hover:border-firouze hover:text-firouze"
                    >
                        { t.howTo }
                    </a>
                </div>
            </div>

            <div class="anim-settle">
                <CodeCapsule
                    code="7f3c1e2a-9b04-4d68-a5c1-0e7b2d9f4a31"
                    label={ t.sampleLabel }
                    scanning={ scanning }
                    verified={ verified }
                />
                <p class="mt-3 text-caption text-muted">{ t.sampleNote }</p>
            </div>
        </section>

        <section class="mx-auto max-w-6xl px-4 pb-section sm:px-5">
            <ul class="stagger grid grid-cols-2 overflow-hidden rounded-2xl border border-line bg-surface lg:grid-cols-4">
                <For each={ ASSURANCES[lang] } key={ (item) => item.label } let={ item }>
                    <li class="trust-cell p-4">
                        <Icon icon={ item.glyph } class="size-5 text-firouze" />
                        <p class="mt-2.5 text-small font-bold">{ item.label }</p>
                        <p class="mt-1 text-caption text-muted">{ item.detail }</p>
                    </li>
                </For>
            </ul>
        </section>

        <section id="cards" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-section sm:px-5">
            <h2 class="font-bold">{ t.cardsTitle }</h2>
            <p class="mt-3 max-w-xl text-muted">{ t.cardsLede }</p>

            <div class="mt-stack">
                <Async
                    loading={ catalog.loading && !catalog.loaded }
                    error={ catalog.error === CATALOG_UNAVAILABLE ? t.cardsFailed : catalog.error }
                    empty={ catalog.loaded && catalog.tiers.length === 0 }
                    emptyText={ t.cardsEmpty }
                    onRetry={ () => void catalog.load() }
                    skeleton={
                        <div class="grid gap-5 md:grid-cols-3">
                            <div class="anim-pulse h-96 rounded-2xl border border-line bg-surface"></div>
                            <div class="anim-pulse h-96 rounded-2xl border border-line bg-surface"></div>
                            <div class="anim-pulse h-96 rounded-2xl border border-line bg-surface"></div>
                        </div>
                    }
                >
                    <div class="grid gap-5 md:grid-cols-3">
                        { /* Keyed on the amount, and each row looks its tier up again by that
                             key: the catalogue polls, and a row kept for the same card must still
                             show the new price and stock. `contents` keeps the wrapper out of
                             the grid. */ }
                        <For each={ catalog.tiers } key={ (tier) => tier.amount } let={ tier }>
                            <div class="contents">
                                <GiftCard
                                    tier={ catalog.tiers.find((fresh) => fresh.amount === tier.amount) ?? tier }
                                />
                            </div>
                        </For>
                    </div>
                </Async>
            </div>
        </section>

        <section id="how" class="border-y border-line bg-surface/40">
            <div class="mx-auto max-w-6xl scroll-mt-20 px-4 py-section sm:px-5">
                <h2 class="font-bold">{ t.stepsTitle }</h2>
                <ol class="mt-stack grid gap-6 md:grid-cols-3">
                    <For each={ STEPS[lang] } key={ (step) => step.title } let={ step } index={ index }>
                        <li class="rounded-2xl border border-line bg-surface p-5">
                            <div class="flex items-center gap-2.5 text-firouze">
                                <Icon icon={ step.glyph } class="size-5 shrink-0" />
                                <span dir="ltr" class="latin inline-block text-caption font-bold">{ index + 1 }</span>
                            </div>
                            <h3 class="mt-3 font-bold">{ step.title }</h3>
                            <p class="mt-2 text-small text-muted">{ step.body }</p>
                        </li>
                    </For>
                </ol>
            </div>
        </section>

        <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-section sm:px-5">
            <h2 class="font-bold">{ t.faqTitle }</h2>

            <div class="mt-6 rounded-2xl border border-line bg-surface px-5">
                <For each={ faqs } key={ (faq) => faq.id } let={ faq }>
                    <div class="contents">
                        <FaqItem
                            id={ faq.id }
                            question={ faq.question }
                            answer={ faq.answer }
                            open={ openFaq === faq.id }
                            onToggle={ toggleFaq }
                        />
                    </div>
                </For>
            </div>
        </section>
    </div>
}
