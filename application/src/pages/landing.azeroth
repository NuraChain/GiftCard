// The landing page - of every language. `/` is the Persian one and `/en`, `/ar`, `/fr`... the
// others; they share this layout and differ in words, and - Persian against the rest - in
// currency, gateway and delivery (see lib/lang.ts).
//
// It argues one thing: what you buy is a code, and this is exactly what happens to it. The
// hero shows that code as the artifact it is, the cards carry the purchase itself, and the
// FAQ answers the fears in the buyer's own words.
//
// The payment RESULT is first on the page rather than last, and renders only when there is
// one. A buyer who lands here is coming back from the gateway and has exactly one question;
// making them scroll past the shop to find the answer would be a strange thing to do to
// somebody who has just paid.
import { CATALOG_UNAVAILABLE, useCatalog, useShopName } from '../lib/catalog.ts';
import { STEPS, FAQS, ASSURANCES } from '../lib/content.ts';
import { useCopy, useLang, type Lang } from '../lib/lang.ts';
import Async from '../ui/async.azeroth';
import Icon from '../ui/icon.azeroth';
import CodeCapsule from '../components/code-capsule.azeroth';
import GiftCard from '../components/gift-card.azeroth';
import FaqItem from '../components/faq-item.azeroth';
import PurchaseResult from '../components/purchase-result.azeroth';

interface LandingCopy {
    kicker: (name: string) => string;
    headline: string;
    lede: string;
    seeCards: string;
    howTo: string;
    sampleLabel: string;
    sampleNote: string;
    cardsTitle: string;
    cardsLede: string;
    cardsEmpty: string;
    cardsFailed: string;
    stepsTitle: string;
    faqTitle: string;
}

