// A label, a control, and the line underneath that explains it.
//
// The `for`/`id` pair is the whole point: a label that is not bound to its control is a
// caption, and tapping it does nothing - which on a phone is the difference between a 44px
// target and a 16px one. Passing the id through here makes the binding impossible to forget.
import type { MountNode } from 'azerothjs';

export interface FieldProps {
    children?: MountNode;
    label: string;

    /** Must match the `id` of the control inside. */
    htmlFor: string;

    /** Sits under the control, quiet. */
    hint?: string;

    /** Replaces the hint and turns red. A field explains itself or it complains. */
    error?: string;

    class?: string;
}

export default component Field(props: FieldProps)
{
    derived error = props.error ?? '';
    derived hint = props.hint ?? '';

    <div class={ props.class ?? '' }>
        <label class="block text-small font-bold" for={ props.htmlFor }>{ props.label }</label>
        <div class="mt-2">{ props.children }</div>
        <Show when={ error !== '' }>
            <p class="mt-1 text-caption font-bold text-danger">{ error }</p>
        </Show>
        <Show when={ error === '' && hint !== '' }>
            <p class="mt-1 text-caption text-muted">{ hint }</p>
        </Show>
    </div>
}
