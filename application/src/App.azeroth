// The shell: navbar, the routed page, and the footer. A single-page marketing site
// still goes through the router so the SSR seam stays intact - `url` pins a memory
// history when the kit prerenders; the browser omits it and reads the address bar.
//
// Layout uses LOGICAL properties throughout (ms/me, ps/pe, start/end). In an RTL
// document a physical `left` is whichever side the design did not mean.
import { ErrorBoundary, RouterProvider, Routes, Link, createRouter, createMemoryHistory } from 'azerothjs';
import type { LoaderHandoff } from 'azerothjs';
import { Link2, Mail, MessageCircle, Phone, Clock } from 'lucide';
import { useCatalog } from './lib/catalog.ts';
import { routes } from './routes.ts';
import { CONTACT } from './lib/content.ts';
import { icon } from './ui/icon.ts';
import ThemeToggle from './components/theme-toggle.azeroth';
import MobileNav from './components/mobile-nav.azeroth';
import ErrorPage from './pages/error.azeroth';
import NotFoundPage from './pages/not-found.azeroth';
import ToastHost from './ui/toast-host.azeroth';

// Absolute, not bare fragments. The bar is shown on every route now, and `#cards` from the
// console would navigate to /admin#cards and scroll nowhere - the link has to name the page
// it belongs to as well as the section.
const NAV_LINKS =
[
    { href: '/#cards', label: 'کارت‌ها' },
    { href: '/#how', label: 'روش خرید' },
    { href: '/#faq', label: 'سوال‌های پرتکرار' }
];

export default component App(props: { url?: string; handoff?: LoaderHandoff })
{
    const router = createRouter({
        routes,
        history: props.url !== undefined ? createMemoryHistory(props.url) : undefined,
        initialLoaderData: props.handoff
    });

    // The shop's name is configuration, not a constant: the console can change it and every
    // place it appears - the tab title, this brand, the footer - follows without a deploy.
    const catalog = useCatalog();

    mount
    {
        if (!catalog.loaded())
        {
            void catalog.load();
        }
    }

    <RouterProvider router={ router }>
        {/* The column is what keeps the footer at the BOTTOM of the viewport on a short page
            (an admin tab with three rows) instead of floating halfway up it: `main` takes the
            slack, so the footer sits under the fold on a long page and on the fold on a short
            one. */}
        <div class="flex min-h-dvh flex-col">
            <a
                href="#main"
                class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:text-small focus:font-bold"
            >
                پرش به محتوای اصلی
            </a>

            <header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur">
                <nav class="relative mx-auto flex min-h-16 max-w-6xl items-center gap-4 px-4 sm:px-5" aria-label="ناوبری اصلی">
                    {/* The brand goes HOME, not to an in-page anchor: `#main` sent the console
                        to /admin#main, which looks broken and leaves the operator stranded. */}
                    <Link to="/" scroll class="flex min-h-tap items-center gap-2 font-bold">
                        { icon(Link2, 'size-6 text-firouze') }
                        { catalog.appName() }
                    </Link>

                    <ul class="ms-6 hidden items-center gap-6 text-small text-muted md:flex">
                        <For each={ NAV_LINKS } key={ (link) => link.href } let={ link }>
                            <li><a class="flex min-h-tap items-center hover:text-ink" href={ link.href }>{ link.label }</a></li>
                        </For>
                    </ul>

                    {/* `ms-auto` belongs HERE, not on the link list: the list is hidden on the
                        console and on phones, and the controls would then bunch against the
                        brand instead of staying pinned to the end of the bar. */}
                    <div class="ms-auto flex items-center gap-2">
                        <ThemeToggle />
                        <MobileNav links={ NAV_LINKS } />
                    </div>
                </nav>
            </header>

            <main id="main" class="flex-1">
                {/* The boundary sits INSIDE the shell, not around it: a page that throws
                    should still leave the reader a header to navigate from and a footer with
                    the support number on it. Wrapping the whole shell would take those with it. */}
                <ErrorBoundary fallback={ (_error, reset) => <ErrorPage reset={ reset } /> }>
                    <Routes fallback={ () => <NotFoundPage /> } />
                </ErrorBoundary>
            </main>

            <ToastHost />

            {/* The console shares this footer rather than hiding it: it is the same product, the
                support contacts in it are the ones an operator quotes, and one shell is one thing
                to keep right. There is deliberately no link TO the console here - an operator
                types the address, and a public link to a login is an invitation. */}
            <footer class="mt-section border-t border-line">
                <div class="mx-auto grid max-w-6xl gap-stack px-4 py-section sm:grid-cols-2 sm:px-5 lg:grid-cols-4">
                    <div class="sm:col-span-2">
                        <p class="flex items-center gap-2 font-bold">
                            { icon(Link2, 'size-5 text-firouze') }
                            { catalog.appName() }
                        </p>
                        <p class="mt-3 max-w-sm text-small text-muted">
                            فروش گیفت کارت با تحویل آنی کد. اگر کدی که خریده‌اید فعال نشود، جایگزین می‌کنیم یا وجه را برمی‌گردانیم.
                        </p>
                    </div>

                    <div>
                        <h2 class="text-h3 font-bold">پشتیبانی</h2>
                        <ul class="mt-3 text-small text-muted">
                            <li>
                                <a class="flex min-h-tap items-center gap-2 hover:text-firouze" href={ `mailto:${ CONTACT.email }` }>
                                    { icon(Mail, 'size-4 shrink-0') }
                                    <span dir="ltr" class="latin">{ CONTACT.email }</span>
                                </a>
                            </li>
                            <li>
                                <a class="flex min-h-tap items-center gap-2 hover:text-firouze" href={ `tel:${ CONTACT.phone.replace(/\s/g, '') }` }>
                                    { icon(Phone, 'size-4 shrink-0') }
                                    <span dir="ltr" class="latin">{ CONTACT.phone }</span>
                                </a>
                            </li>
                            <li class="flex min-h-tap items-center gap-2">
                                { icon(MessageCircle, 'size-4 shrink-0') }
                                <span dir="ltr" class="latin">{ CONTACT.telegram }</span>
                            </li>
                            <li class="flex min-h-tap items-center gap-2">
                                { icon(Clock, 'size-4 shrink-0') }
                                { CONTACT.hours }
                            </li>
                        </ul>
                    </div>

                    <div>
                        <h2 class="text-h3 font-bold">راهنما</h2>
                        <ul class="mt-3 text-small text-muted">
                            <For each={ NAV_LINKS } key={ (link) => link.href } let={ link }>
                                <li>
                                    <a class="flex min-h-tap items-center hover:text-firouze" href={ link.href }>{ link.label }</a>
                                </li>
                            </For>
                        </ul>
                    </div>
                </div>

                <div class="border-t border-line">
                    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-5 text-caption text-muted sm:px-5">
                        <p>گردانندهٔ سرویس: { CONTACT.operator }</p>
                        {/* `dir="ltr"` on the name only: the sentence is Persian and stays RTL,
                            but a Latin product name inside it would otherwise be reordered
                            against the punctuation around it. */}
                        <p class="shrink-0">
                            ساخته‌شده با
                            <a
                                class="text-firouze no-underline hover:text-ink"
                                href="https://github.com/AzerothJS/AzerothJS"
                                target="_blank"
                                rel="noreferrer"
                            ><span dir="ltr" class="latin">AzerothJS</span></a>
                        </p>
                    </div>
                </div>
            </footer>
        </div>
    </RouterProvider>
}
