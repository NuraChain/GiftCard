# Copy to .env, HERE at the repository root. Never commit .env.
#
# The server reads this one file however it is started: `npm start --workspace server`, `npm run
# dev`, or the Docker image with it mounted at /app/.env (see the Dockerfile).
#
# This file holds ONLY what the database cannot: where the process listens, how it is fronted,
# and where its database is. Everything else - the catalogue, the tether rate, the
# margin, the gateway and SMS credentials, the public address, the console key - lives in the
# console and is edited there.
#
# Every value below but DATABASE_URL has a working default. Sign in at /admin with the default
# key 2222-2222-2222-2222 and configure the rest from the settings tab.
# CHANGE THAT KEY BEFORE THE SHOP IS REACHABLE FROM THE INTERNET - it is written down here, so
# until you change it, so is your console.

PORT=4600
# Loopback, so only the proxy on this machine can reach it. The Docker image sets 0.0.0.0, and
# its own value wins over this one.
HOST=127.0.0.1
NODE_ENV=production

# --- Being behind a proxy ---

# How many proxies sit in front. The per-IP throttles and the console's sign-in lockout are
# only as good as this number: at 0 every buyer shares nginx's address and one attacker locks
# out the whole shop, and trusting the whole chain would let a client forge its own address.
# One nginx in front means 1. Running the API directly, with nothing in front, means 0.
#
# The other half of this is your proxy config, which must OVERWRITE X-Forwarded-For rather
# than appending to it (nginx's usual $proxy_add_x_forwarded_for appends). Both are needed;
# either alone is decorative.
TRUST_PROXY_HOPS=1

# Adds `Secure` to the session cookie. It cannot be inferred from the request: nginx
# terminates TLS, so this process always sees plain http even when the browser is on https.
# On wherever nginx serves https - which is everywhere but a local dev machine.
COOKIE_SECURE=false

# --- Storage ---

# The gift codes, the order ledger, the catalogue and the settings, in PostgreSQL. Required.
# The database must be UTF8; the shop makes its own tables in it on first start.
#
# TREAT THIS DATABASE AS THE BUSINESS. It holds unsold codes, which are money, and the
# credentials of the account they are paid into, stored as given - there is no encryption at
# rest, because a key kept beside the ciphertext protects nothing. Back it up, and keep it off
# any disk a redeploy wipes. The scheduled Telegram backup is a SQL dump of it.
#
# The URL carries the password: postgres://ashbringer:<password>@127.0.0.1:5432/ashbringer
# Inside Docker, 127.0.0.1 is the container itself: name the database host instead (on the
# same machine, host.docker.internal - see the Dockerfile).
DATABASE_URL=postgres://ashbringer@127.0.0.1:5432/ashbringer
# Connections the pool may hold.
DATABASE_POOL_SIZE=10

# --- Tests ---

# The server suite's own database: one it may create and drop schemas in, never the shop's.
# Only this key of the file is read by the suite.
TEST_DATABASE_URL=postgres://ashbringer@127.0.0.1:5432/ashbringer_test
